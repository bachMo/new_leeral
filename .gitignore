eval/.pytest_cache/
eval/.ruff_cache/
eval/__pycache__/

# Sources brutes téléchargées pour construire le lexique (api/scripts/lexicon/) : jamais modifiées
# ni versionnées. Le lexique construit (app/ai/real/data/) reste versionné.
api/data/raw/